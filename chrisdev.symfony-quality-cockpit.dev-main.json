{
    "manifests": {
        "chrisdev/symfony-quality-cockpit": {
            "manifest": {
                "bundles": {
                    "Chrisdev\\QualityCockpit\\QualityCockpitBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "<bg=blue;fg=white> Quality Cockpit </>",
                    "",
                    "  The bundle is enabled and its routes/configuration were installed.",
                    "  Add these paths to your frontend build so Tailwind and Stimulus include the bundle:",
                    "",
                    "  @source \"../../vendor/chrisdev/symfony-quality-cockpit/templates/**/*.twig\";",
                    "  @source \"../../vendor/chrisdev/symfony-quality-cockpit/src/**/*.php\";",
                    "",
                    "  import the bundle controllers from:",
                    "  vendor/chrisdev/symfony-quality-cockpit/assets/controllers/"
                ]
            },
            "files": {
                "config/packages/chris_dev_symfony_quality_cockpit.yaml": {
                    "contents": [
                        "quality_cockpit:",
                        "    enabled: true",
                        "    route_prefix: '/_quality'",
                        "    reports:",
                        "        base_directory: '%kernel.project_dir%/var/reports'",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/quality_cockpit.yaml": {
                    "contents": [
                        "quality_cockpit:",
                        "    resource: '@QualityCockpitBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "a7c1e4f9b2d6458ca0e7d3f6b1c9a582e4f0d713"
        }
    }
}
