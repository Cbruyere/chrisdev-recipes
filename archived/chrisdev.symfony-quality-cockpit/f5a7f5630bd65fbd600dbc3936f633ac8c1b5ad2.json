{
    "manifests": {
        "chrisdev/symfony-quality-cockpit": {
            "manifest": {
                "bundles": {
                    "Chrisdev\\QualityCockpit\\QualityCockpitBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "<bg=blue;fg=white> Quality Cockpit </>",
                    "",
                    "  The bundle is enabled and its routes/configuration were installed.",
                    "  Add these paths to your frontend build so Tailwind and Stimulus include the bundle:",
                    "",
                    "  @source \"../../vendor/chrisdev/symfony-quality-cockpit/templates/**/*.twig\";",
                    "  @source \"../../vendor/chrisdev/symfony-quality-cockpit/src/**/*.php\";",
                    "",
                    "  import the bundle controllers from:",
                    "  vendor/chrisdev/symfony-quality-cockpit/assets/controllers/"
                ],
                "add-lines": [
                    {
                        "file": "assets/styles/app.css",
                        "content": "\nenables the Symfony UX Stimulus bridge (used in assets/styles/app.css)\n    @source \"../../vendor/chrisdev/symfony-quality-cockpit/templates/**/*.twig\";",
                        "position": "bottom"
                    },
                    {
                        "file": "assets/styles/app.css",
                        "content": "\nenables the Symfony UX Stimulus bridge (used in assets/styles/app.css)\n    @source \"../../vendor/chrisdev/symfony-quality-cockpit/src/**/*.php\";",
                        "position": "bottom"
                    }
                ],
                "ref": "ffa5547a461594e957f6e87fafd002fb071ca789"
            },
            "files": {
                "config/packages/chris_dev_symfony_quality_cockpit.yaml": {
                    "contents": [
                        "quality_cockpit:",
                        "    enabled: true",
                        "    route_prefix: '/quality'",
                        "    reports:",
                        "        base_directory: '%kernel.project_dir%/var/reports'",
                        "    thresholds:",
                        "        phpunit:",
                        "            excellent: 90",
                        "            good: 80",
                        "            warning: 65",
                        "            degraded: 50",
                        "        infection:",
                        "            excellent: 100",
                        "            very_good: 95",
                        "            good: 85",
                        "            warning: 70",
                        "            degraded: 60",
                        "        phpmetrics:",
                        "            warning_classes: 1",
                        "            degraded_classes: 5",
                        "            critical_classes: 15",
                        "    freshness:",
                        "        warning_after_hours: 24",
                        "        stale_after_hours: 72",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/quality_cockpit.yaml": {
                    "contents": [
                        "quality_cockpit:",
                        "    resource: '@QualityCockpitBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "f5a7f5630bd65fbd600dbc3936f633ac8c1b5ad2"
        }
    }
}
